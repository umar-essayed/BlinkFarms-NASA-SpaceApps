# ==============================================================================
# BlinkFarms — Environment Variables Configuration
# ==============================================================================

# 1. Supabase PostgreSQL & pgvector Credentials
# Get these from your Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Frontend public access
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. NASA API Configuration (Optional - POWER API is open and keyless by default)
NASA_EARTHDATA_USERNAME=your_username
NASA_EARTHDATA_PASSWORD=your_password

# 3. Port Configuration
PORT=3001
